##FigureS1B
Idents(Myeloid) <- Myeloid$Cancer
NSCLC <- subset(Myeloid,idents="NSCLC")
BRC <- subset(Myeloid,idents="BRC")
CRC <- subset(Myeloid,idents="CRC")
HCC <- subset(Myeloid,idents="HCC")

meta <- NSCLC@meta.data
orig_stats <- meta %>%
  group_by(orig.ident, responsess) %>%
  mutate(total_cells = n()) %>%
  group_by(orig.ident, responsess, cell.type) %>%
  summarise(
    cell_count = n(),
    total_cells = first(total_cells),
    cell_ratio = cell_count / total_cells
  ) %>%
  ungroup()
orig_stats$responsess <- factor(orig_stats$responsess,levels = c("Responder","Non-Responder"))
plot_data <- orig_stats %>%
  group_by(cell.type, responsess) %>%
  summarise(
    mean_ratio = mean(cell_ratio),
    se_ratio = sd(cell_ratio)/sqrt(n()),
    .groups = "drop"
  )
p <- ggplot() +
  geom_col(
    data = plot_data,
    aes(x = cell.type, y = mean_ratio, fill = responsess),
    width = 0.7, 
    position = position_dodge(width = 0.8),
    alpha = 0.8
  ) +
  geom_errorbar(
    data = plot_data,
    aes(x = cell.type, ymin = mean_ratio - se_ratio, ymax = mean_ratio + se_ratio, group = responsess),
    width = 0.2,
    position = position_dodge(width = 0.8)
  ) +
  labs(
    x = "",
    y = "proportion",
    fill = "cell.type",
    title = "NSCLC"
  ) +
  theme_bw() +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1, size = 10),
    axis.text.y = element_text(size = 10),
    axis.title = element_text(size = 12, face = "bold"),
    legend.title = element_text(size = 11, face = "bold"),
    legend.text = element_text(size = 10),
    plot.title = element_text(size = 13, face = "bold", hjust = 0.5)
  ) +
  scale_fill_manual(values = c("Responder" = "#1F78B4", "Non-Responder" = "#E31A1C"))+
  stat_compare_means(method = "wilcox.test",comparisons = list(c("Responder","Non-Responder"))
print(p)


