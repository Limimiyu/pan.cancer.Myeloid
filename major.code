##Figure2C
group_levels <- c("tumor.NR.post","tumor.R.post","tumor.NR.pre","tumor.R.pre","tumor.R.On")
comparison_pairs <- list(
  NR.R.post       = c("tumor.NR.post", "tumor.R.post"),
  NR.R.pre        = c("tumor.NR.pre",  "tumor.R.pre"),
  NR.NR.pre.post  = c("tumor.NR.post", "tumor.NR.pre"),
  R.R.pre.post    = c("tumor.R.post",  "tumor.R.pre"),
  R.R.pre.On      = c("tumor.R.pre",   "tumor.R.On"),
  R.R.post.On     = c("tumor.R.post",  "tumor.R.On")
)
all_myeloid_meta <- rownames(meta)
all_myeloid_meta <- all_myeloid_meta %>%filter(group %in% group_levels)
sample_total <- all_myeloid_meta %>%group_by(orig.ident) %>%summarise(total_myeloid = n(),.groups = "drop")
sample_cancer <- all_myeloid_meta %>%dplyr::select(orig.ident, Cancer) %>%distinct()
group_col_panel <- c("tumor.NR.post" = "#F28E8B","tumor.R.post" = "#F4A6B8","tumor.NR.pre" = "#5B8CCB","tumor.R.pre" = "#8C6BB1","tumor.R.On" = "#B67A59")
analyse_one_subset <- function(seu,subtype,cell.type_col = "cell.type") {
  meta <- seu@meta.data
  cells_use <- rownames(meta)[meta[[cell.type_col]] == subtype &meta$group %in% group_levels]
  obj <- subset(seu,cells = cells_use)
  subset_count <- obj@meta.data %>%group_by(orig.ident,group) %>%summarise(subset_count = n(),.groups = "drop")
  sample_info <- all_myeloid_meta %>%dplyr::select(orig.ident,Cancer,group) %>%distinct()
  prop_data <- sample_info %>%left_join(subset_count,by = c("orig.ident","group")) %>%mutate(subset_count = replace_na(subset_count,0)) %>%left_join(sample_total,by = "orig.ident") %>% mutate(proportion =subset_count / total_myeloid,cell.type = subtype)
  prop_data$group <- factor(prop_data$group,levels = group_levels)
  safe_wilcox <- function(df, g1, g2) {x <- df$proportion[df$group == g1]
  y <- df$proportion[df$group == g2]
  x <- x[!is.na(x)]
  y <- y[!is.na(y)]
  if (length(x) == 0 ||length(y) == 0) {return(NA_real_)}
  tryCatch(wilcox.test(x,y,exact = FALSE)$p.value,error = function(e) NA_real_)}
  stats_list <- lapply(
    names(comparison_pairs),
    function(pair_name) {
      pair <- comparison_pairs[[pair_name]]
      prop_data %>%filter(group %in% pair) %>%group_by(Cancer) %>%group_modify(~ tibble(n_group1 = sum(.x$group == pair[1]),n_group2 = sum(.x$group == pair[2]),p_value = safe_wilcox(.x,pair[1],pair[2]))) %>%ungroup() %>%mutate(comparison = pair_name,group1 = pair[1],group2 = pair[2])
    })
  stats_data <- bind_rows(stats_list)
  stats_data <- stats_data %>%mutate(p_signif = case_when(is.na(p_value)   ~ NA_character_,p_value < 0.001  ~ "***",p_value < 0.01   ~ "**",p_value < 0.05   ~ "*",TRUE~ "ns"))
  plot_data <- prop_data %>%group_by(Cancer,group) %>%summarise(mean_prop =mean(proportion,na.rm = TRUE),n = n(),se =ifelse(n() > 1,sd(proportion,na.rm = TRUE) / sqrt(n()),0),.groups = "drop")
  cancer_levels <- c("BRC","ccRC","CRC","GBM","GC","HCC","HNSCC","NSCLC")
  cancer_levels <- cancer_levels[cancer_levels %in%unique(as.character(plot_data$Cancer))]
  plot_data$Cancer <- factor(plot_data$Cancer,levels = cancer_levels)
  prop_data$Cancer <- factor(prop_data$Cancer,levels = cancer_levels)
  stats_data$Cancer <- factor(stats_data$Cancer,levels = cancer_levels)
  stats_sig <- stats_data %>%filter(!is.na(p_value),p_value < 0.05)
  dodge_width <- 0.8
  n_groups <- length(group_levels)
  offsets <- seq(-dodge_width / 2 + dodge_width / (2 * n_groups),dodge_width / 2 - dodge_width / (2 * n_groups),length.out = n_groups)
  names(offsets) <- group_levels
  if (nrow(stats_sig) > 0) {
    stats_sig <- stats_sig %>%mutate(cancer_num =match(as.character(Cancer),cancer_levels),xmin =cancer_num +offsets[as.character(group1)],xmax =cancer_num +offsets[as.character(group2)])
    cancer_max <- plot_data %>%group_by(Cancer) %>%summarise(ymax =max(mean_prop + se,na.rm = TRUE),.groups = "drop")
    overall_max <- max(plot_data$mean_prop +plot_data$se,na.rm = TRUE)
    if (overall_max == 0) {overall_max <- 0.001}
    stats_sig <- stats_sig %>%left_join(cancer_max,by = "Cancer") %>%group_by(Cancer) %>%arrange(comparison,.by_group = TRUE) %>%mutate(sig_order =row_number(),y.position =ymax +overall_max *0.08 *sig_order,tip =overall_max *0.015) %>%ungroup()
  }
  p <- ggplot(plot_data,aes(x = Cancer,y = mean_prop,fill = group)) +
    geom_col(position =position_dodge(width = dodge_width),width = 0.7) +
    geom_errorbar(aes(ymin =pmax(mean_prop - se,0),ymax =mean_prop + se),position =position_dodge(width = dodge_width),width = 0.6,linewidth = 0.65) +
    scale_fill_manual(values = group_col_panel,drop = FALSE) +
    labs(title = subtype,x = NULL,y = "Proportion",fill = NULL) +
    theme_classic() +
    theme(plot.title =element_text(hjust = 0.5,face = "bold",size = 11),axis.text.x =element_text(angle = 45,hjust = 1,vjust = 1,size = 8),axis.text.y =element_text(size = 8),axis.title.y =element_text(size = 9),legend.position ="bottom",legend.text =element_text(size = 8))
  if (nrow(stats_sig) > 0) {
    p <- p +
      geom_segment(data = stats_sig,aes(x = xmin,xend = xmax,y = y.position,yend = y.position),inherit.aes = FALSE,linewidth = 0.3) +
      geom_segment(data = stats_sig,aes(x = xmin,xend = xmin,y = y.position,yend = y.position - tip),inherit.aes = FALSE,linewidth = 0.3) +
      geom_segment(data = stats_sig,aes(x = xmax,xend = xmax,y = y.position,yend = y.position - tip),inherit.aes = FALSE,linewidth = 0.3) +
      geom_text(data = stats_sig,aes(x =(xmin + xmax) / 2,y =y.position,label =p_signif),inherit.aes = FALSE,vjust = -0.25,size = 3)
  }
  p <- p +scale_y_continuous(expand = expansion(mult = c(0,0.20)))+scale_y_sqrt()
  return(list(roportion = prop_data,plot_data = plot_data,stats = stats_data,plot = p))
}
res_Macro_STMN1 <- analyse_one_subset(Mono,"Macro_STMN1")
res_Macro_SLC40A1 <- analyse_one_subset(Mono,"Macro_SLC40A1")
res_Macro_SPP1 <- analyse_one_subset(Mono,"Macro_SPP1")
res_Macro_CCL4 <- analyse_one_subset(Mono,"Macro_CCL4")
res_Macro_FCBBP <- analyse_one_subset(Mono,"Macro_FCGBP")
res_cDC1_CLEC9A <- analyse_one_subset(DC,"cDC1_CLEC9A")
res_cDC2_C1QC <- analyse_one_subset(DC,"cDC2_C1QC")
res_cDC3_LAMP3 <- analyse_one_subset(DC,"cDC3_LAMP3")
res_pDC_LILRA4 <- analyse_one_subset(DC,"pDC_LILRA4")
final_plot <- (res_Macro_STMN1$plot +res_Macro_SLC40A1$plot) / (res_Macro_SPP1$plot +res_Macro_CCL4$plot) / (res_cDC1_CLEC9A$plot +res_cDC2_C1QC$plot) / (res_cDC3_LAMP3$plot +res_pDC_LILRA4$plot) +plot_layout(guides = "collect") &theme(legend.position = "bottom")
final_plot
all_stats <- bind_rows(
  res_Macro_STMN1$stats,
  res_Macro_SLC40A1$stats,
  res_Macro_SPP1$stats,
  res_Macro_CCL4$stats,
  res_Macro_FCGBP$stats,
  res_cDC1_CLEC9A$stats,
  res_cDC2_C1QC$stats,
  res_cDC3_LAMP3$stats,
  res_pDC_LILRA4$stats,
  .id = "result"
)

