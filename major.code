##Figure2B
Mono <- readRDS("Mono.rds")
DC <- readRDS("DC.rds")
Neu <- readRDS("Neu.rds")
process_celltype <- function(cell_obj, celltype_name, sample_types = c("ANT", "pbmc", "tumor")) {
  require(dplyr)
  require(tidyr)
  require(purrr)
  require(reshape2)
  results <- list()
  for (sample in sample_types) {
    message("\nProcessing sample: ", sample)
    message("Cell types in object: ", toString(unique(cell_obj$cell.type)))
    Idents(cell_obj) <- "site"  
    subsetted_data <- subset(cell_obj, idents = sample)
    if (ncol(subsetted_data) == 0) {
      warning("No cells found for sample: ", sample)
      next
    }
    prop_data <- subsetted_data@meta.data %>%group_by(orig.ident,cell.type, group) %>%
      summarise(count = n(), .groups = "drop") %>%
      group_by(orig.ident) %>%
      mutate(proportion = count / sum(count), proportion = ifelse(proportion < 0.01, 0, proportion)) %>%
      ungroup()
    if (nrow(prop_data) == 0) {
      warning("prop_data is empty for sample: ", sample)
      next
    }
    prop_data$group <- factor(
      prop_data$group,
      levels = c("tumor.NR.post", "tumor.R.post", "tumor.NR.pre", "tumor.R.pre", "tumor.R.On",
                 "pbmc.NR.post", "pbmc.R.post", "pbmc.NR.pre", "pbmc.R.pre", "pbmc.NR.On", "pbmc.R.On",
                 "ANT.NR.post", "ANT.R.post", "ANT.NR.pre", "ANT.R.pre", "ANT.R.On")
    )
    prop_summary <- prop_data %>%
      group_by(cell.type, group) %>%
      summarise(mean_proportion = mean(proportion, na.rm = TRUE), .groups = "drop")
    wide_data <- dcast(prop_summary, group ~ cell.type, value.var = "mean_proportion", fill = 0)
    if (sample %in% c("ANT", "tumor")) {
      group_pairs <- list(
        c(paste0(sample, ".NR.post"), paste0(sample, ".NR.pre")),
        c(paste0(sample, ".NR.post"), paste0(sample, ".R.post")),
        c(paste0(sample, ".NR.pre"), paste0(sample, ".R.pre")),
        c(paste0(sample, ".R.post"), paste0(sample, ".R.pre")),
        c(paste0(sample, ".R.pre"), paste0(sample, ".R.On")),
        c(paste0(sample, ".R.post"), paste0(sample, ".R.On"))
      )
    } else if (sample == "Blood") {
      group_pairs <- list(
        c("pbmc.NR.post", "pbmc.NR.pre"),
        c("pbmc.NR.post", "pbmc.R.post"),
        c("pbmc.NR.pre", "pbmc.R.pre"),
        c("pbmc.R.post", "pbmc.R.pre"),
        c("pbmc.R.pre", "pbmc.R.On"),
        c("pbmc.R.post", "pbmc.R.On"),
        c("pbmc.NR.post", "pbmc.NR.On"),
        c("pbmc.NR.pre", "pbmc.NR.On")
      )
    }
    ratio_results <- map_df(colnames(wide_data)[-1], function(cell_type) {
      map_df(group_pairs, function(pair) {
        numerator <- wide_data[[cell_type]][wide_data$group == pair[1]]
        denominator <- wide_data[[cell_type]][wide_data$group == pair[2]]
        tibble(cell.type = cell_type,ratio = ifelse(length(numerator) == 0 | length(denominator) == 0 | denominator == 0, NA, log(numerator / denominator)),comparison = paste(pair[1], "/", pair[2]),sample_type = sample,cell_class = celltype_name)})})
    if (nrow(ratio_results) > 0) {
      ratio_wide <- ratio_results %>%
        pivot_wider(names_from = comparison, values_from = ratio) %>%
        mutate(across(where(is.numeric), ~ ifelse(is.na(.), 1, .)))
      results[[sample]] <- ratio_wide
    } else {
      warning("No ratio results for sample: ", sample)
    }
  }
  return(results)
}
celltype_list <- list(Mono = Mono,
                      DC=DC ,
                      Neu=Neu)
processed_data <- map2(celltype_list, names(celltype_list), function(cell_obj, name) {
  process_celltype(cell_obj, name)
})
##tumor
tumor_ratio <- processed_data %>%purrr::map(~ .x[["tumor"]]) %>%purrr::discard(is.null) %>%dplyr::bind_rows(.id = "cell_class")
tumor_ratio <- as.data.frame(tumor_ratio)
rownames(tumor_ratio) <- tumor_ratio$cell.type
tumor_ratio <- tumor_ratio[,-c(1,2,3)]
tumor_ratio[tumor_ratio>2] <- 2

##blood
blood_ratio <- processed_data %>%purrr::map(~ .x[["pbmc"]]) %>%purrr::discard(is.null) %>%dplyr::bind_rows(.id = "cell_class")
blood_ratio <- as.data.frame(blood_ratio)
rownames(blood_ratio) <- blood_ratio$cell.type
blood_ratio <- blood_ratio[,-c(1,2,3)]
blood_ratio[blood_ratio>2] <- 2
blood_ratio <- blood_ratio[c("Mono_CD16","Mono_CD14_DLEU2","Mono_CD14_CSMD1","Mono_CD14_JARID2","Mono_CD14_LGALS2","Mono_CD14_TNF","Mono_CD14_PADI4","Mono_CD14_PPBP","Intermediate Monocyte","cDC3_LAMP3","cDC2_CXCL9","pDC_LILRA4","cDC2_ENHO","cDC2_IL1R2","cDC2_FCN1","cDC2_DLEU2","cDC2_CCL4","cDC2_C1QC","cDC1_CLEC9A","cDC2_CD207","Neu_VCAN","Neu_CCL4","Neu_IL1B","Neu_NECTIN2","Neu_MMP8","Neu_TMCC1","Neu_SLC16A3","Neu_CD74","Neu_MKI67","Neu_HSPA1A","Neu_SCGB3A1","Neu_NAMPTP1","Neu_ISG15"),]

##ANT
ant_ratio <- processed_data %>%purrr::map(~ .x[["ANT"]]) %>%purrr::discard(is.null) %>%dplyr::bind_rows(.id = "cell_class")
ant_ratio <- as.data.frame(ant_ratio)
rownames(ant_ratio) <- ant_ratio$cell.type
ant_ratio <- ant_ratio[,-c(1,2,3)]
ant_ratio <- ant_ratio%>% mutate(across(everything(),~ifelse(is.na(.),1,.)))
ant_ratio[ant_ratio>2] <- 2



tumor_ratio_long <- tumor_ratio %>%
  as.data.frame() %>%
  rownames_to_column(var = "row") %>%
  pivot_longer(-row, names_to = "col", values_to = "value")
tumor_ratio_df <- as.data.frame(tumor_ratio)
tumor_ratio_df$row <- rownames(tumor_ratio_df)
tumor_ratio_long <- melt(tumor_ratio_df,id.vars = "row",variable.name = "comparison",value.name = "ratio")
desired_order <- c(
  "tumor.R.post / tumor.R.On",
  "tumor.R.pre / tumor.R.On",
  "tumor.R.post / tumor.R.pre",
  "tumor.NR.post / tumor.NR.pre",
  "tumor.NR.pre / tumor.R.pre",
  "tumor.NR.post / tumor.R.post"
)

tumor_ratio_long$comparison <- factor(
  tumor_ratio_long$comparison,
  levels = desired_order,
  ordered = TRUE
)

tumor_ratio_long$row <- factor(tumor_ratio_long$row,levels = c("Macro_CXCL9","Macro_CCL4","Macro_STMN1","Macro_MRC1","Macro_SPP1","Macro_SLC40A1","Macro_FCGBP","Macro_CCL20","Macro_TREM2","Mono_CD14_TNF","Mono_CD14_PPBP","Mono_CD14_PADI4","Mono_CD14_LGALS2","Mono_CD14_JARID2","Mono_CD14_DLEU2","Mono_CD14_CSMD1","Intermediate Monocyte","Mono_CD16","Neu_CCL4","Neu_SCGB3A1","Neu_NECTIN2","Neu_NAMPTP1","Neu_MMP8","Neu_MKI67","Neu_ISG15","Neu_IL1B","Neu_HSPA1A","Neu_CD74","Neu_SLC16A3","Neu_TMCC1","Neu_VCAN","pDC_LILRA4","cDC3_LAMP3","cDC2_IL1R2","cDC2_FCN1","cDC2_ENHO","cDC2_CXCL9","cDC2_DLEU2","cDC2_CD207","cDC2_CCL4","cDC2_C1QC","cDC1_CLEC9A"))

p1 <- ggplot(tumor_ratio_long, aes(x = comparison, y = row, fill = ratio)) +
  geom_tile(color = "white", size = 0.2) +
  scale_fill_gradientn(
    colors = c("#1F78B4", "#FFFFFF", "#FFFFFF", "#E31A1C"),
    values = c(0, 0.35, 0.65, 1),
    breaks = c(0, 0.4, 1.6, 2),
    limits = c(0, 2),
    na.value = "grey80"
  ) +
  theme_bw() +
  theme(
    axis.text.x = element_text(angle = 90, hjust = 1, vjust = 0.5, size = 13, colour = "black"),
    axis.text.y = element_text(size = 12, colour = "black"),
    axis.title = element_blank(),
    panel.grid = element_blank(),
    legend.title = element_text(size = 12),
    legend.text = element_text(size = 10),
    plot.title = element_text(size = 14, hjust = 0.5)
  ) +
  labs(
    fill = "proportion(ratio)",
    title = "The proportion of Myeloid cells between Tumor groups"
  ) +
  coord_flip()+NoLegend()



