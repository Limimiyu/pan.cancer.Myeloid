Idents(Myeloid) <- Myeloid$responsess
NR <- subset(Myeloid,idents="Non-Responder")
R <- subset(Myeloid,idents="Responder")
meta <- NR@meta.data
orig_stats <- meta %>%
  group_by(orig.ident, status) %>%
  mutate(total_cells = n()) %>%
  group_by(orig.ident, status, cell.type) %>%
  summarise(
    cell_count = n(),
    total_cells = first(total_cells),
    cell_ratio = cell_count / total_cells
  ) %>%
  ungroup()
orig_stats$status <- factor(orig_stats$status,levels = c("Pre","On","Post"))
plot_data <- orig_stats %>%
  group_by(cell.type, status) %>%
  summarise(
    mean_ratio = mean(cell_ratio),
    se_ratio = sd(cell_ratio)/sqrt(n()),
    .groups = "drop"
  )
p <- ggplot() +
  geom_col(
    data = plot_data,
    aes(x = cell.type, y = mean_ratio, fill = status),
    width = 0.7, 
    position = position_dodge(width = 0.8),
    alpha = 0.8
  ) +
  geom_errorbar(
    data = plot_data,
    aes(x = cell.type, ymin = mean_ratio - se_ratio, ymax = mean_ratio + se_ratio, group = status),
    width = 0.2,
    position = position_dodge(width = 0.8)
  ) +
  labs(
    x = "",
    y = "proportion",
    fill = "Status",
    title = "Non-Responder"
  ) +
  theme_bw() +
  theme(
    axis.text.x = element_text(angle = 45, hjust = 1, size = 10),
    axis.text.y = element_text(size = 10),
    axis.title = element_text(size = 12, face = "bold"),
    legend.title = element_text(size = 11, face = "bold"),
    legend.text = element_text(size = 10),
    plot.title = element_text(size = 13, face = "bold", hjust = 0.5)
  ) +
  scale_fill_manual(values = c("On" = "#FF6B6B", "Pre" = "#4ECDC4", "Post" = "#7B68EE"))
print(p)

