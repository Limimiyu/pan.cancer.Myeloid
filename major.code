Idents(SLC40A1) <- SLC40A1$group
SLC40A1 <- subset(SLC40A1,idents=c("tumor.R.post","tumor.NR.post"))
Hypoxic <- read.table("Hypoxia")
Hypoxic <- as.character(Hypoxic$V1)
chemokine <- read.table("chemokine")
chemokine <- as.character(chemokine$V1)
cells_rankings <- AUCell_buildRankings(SLC40A1@assays$RNA@data,plotStats = FALSE)
cells_AUC.Hypoxic <- AUCell_calcAUC(Hypoxic, cells_rankings,aucMaxRank=nrow(cells_rankings)*0.1)
cells_AUC.Hypoxic <- as.numeric(getAUC(cells_AUC.Hypoxic))
SLC40A1$Hypoxic <- cells_AUC.Hypoxic
meta <- SLC40A1@meta.data
meta <- meta[,c("Cancer","Hypoxic","group")]
meta$Cancer <- factor(meta$Cancer,levels = c("NSCLC","BRC","CRC"))
ggplot(meta, aes(x = Cancer, y = Hypoxic, fill = group)) +
  geom_violin(width = 0.8, size = 0.8, scale = "width", 
              position = position_dodge(width = 0.8),
              fill = "white",               
              aes(color = group)) +          
  geom_boxplot(width = 0.3, size = 0.5, 
               position = position_dodge(width = 0.8),
               outlier.size = 1,
               color = "black") +       
  theme_classic() +
  scale_fill_manual(values = group_col_panel) +  
  scale_color_manual(values = group_col_panel) + 
  geom_hline(aes(yintercept = median(Hypoxic)), linetype = "dashed")+
  theme(axis.text.x = element_text(size = 13,angle = 45,hjust = 1,vjust = 1,colour = "black"),axis.title.x = element_blank(),axis.text.y = element_text(size = 12,colour = "black"),axis.title.y = element_text(size = 14,colour = "black"))
cells_AUC.chemokine <- AUCell_calcAUC(chemokine, cells_rankings,aucMaxRank=nrow(cells_rankings)*0.1)
cells_AUC.chemokine <- as.numeric(getAUC(cells_AUC.chemokine))
SLC40A1$chemokine <- cells_AUC.chemokine
meta <- SLC40A1@meta.data
meta <- meta[,c("Cancer","chemokine","group")]
meta$Cancer <- factor(meta$Cancer,levels = c("BRC","NSCLC","CRC"))
ggplot(meta, aes(x = Cancer, y = chemokine, fill = group)) +
  geom_violin(width = 0.8, size = 0.8, scale = "width", 
              position = position_dodge(width = 0.8),
              fill = "white",               
              aes(color = group)) +          
  geom_boxplot(width = 0.3, size = 0.5, 
               position = position_dodge(width = 0.8),
               outlier.size = 1,outlier.shape  = NA,
               color = "black") +       
  theme_classic() +
  scale_fill_manual(values = group_col_panel) +  
  scale_color_manual(values = group_col_panel) + 
  geom_hline(aes(yintercept = median(chemokine)), linetype = "dashed")+
  theme(axis.text.x = element_text(size = 13,angle = 45,hjust = 1,vjust = 1,colour = "black"),axis.title.x = element_blank(),axis.text.y = element_text(size = 12,colour = "black"),axis.title.y = element_text(size = 14,colour = "black"))
SLC40A1 <- subset(Mono,idents="Macro_SLC40A1")
SLC40A1$diff <- paste0(SLC40A1$Cancer,"-",SLC40A1$group)
Idents(SLC40A1) <- SLC40A1$site
SLC40A1 <- subset(SLC40A1,idents="tumor")
Idents(SLC40A1) <- SLC40A1$diff
SLC40A1$diff <- factor(SLC40A1$diff,levels = c("CRC-tumor.R.post","CRC-tumor.NR.post","NSCLC-tumor.R.post","NSCLC-tumor.NR.post","BRC-tumor.R.post","BRC-tumor.NR.post"))
Idents(SLC40A1) <- SLC40A1$diff
DotPlot(SLC40A1, features = c("HIF1A","CCL18","CXCL2,"CXCL8","CCL3L1"))+ scale_colour_gradientn(colours  = brewer.pal(9, "RdBu")[9:1],na.value="transparent")+theme(axis.title=element_blank(),axis.text.y =element_text(size = 13,face = "italic"),axis.text.x = element_text(size = 12,angle = 45,hjust = 1,vjust = 1),strip.background =element_rect(colour = "white")) +labs(title = "cDC1_CLEC9A")+coord_flip()


##Figure3C
Mono <- readRDS("Mono.rds")
CD45 <- readRDS("CD45.rds")
Idents(Mono) <- Mono$site
Mono <- subset(Mono,idents="tumor")
Idents(Mono) <- Mono$cell.type
SLC40A1 <- subset(Mono,idents="Macro_SLC40A1")
CD45 <- merge(CD45,y=c(SLC40A1))
Idents(CD45) <- CD45$group
CD45 <- subset(CD45,idents=c("tumor.R.post","tumor.NR.post"))
CD45$diff <- paste0(CD45$cell.type,"-",CD45$group)
CD45@active.ident <- as.factor(CD45$diff)
ligand_target_matrix = readRDS("nichenet/ligand_target_matrix_nsga2r_final.rds")
lr_network = readRDS("nichenet/lr_network_human_21122021.rds")
weighted_networks = readRDS("nichenet/weighted_networks_nsga2r_final.rds")
weighted_networks_lr = weighted_networks$lr_sig %>% inner_join(lr_network %>% distinct(from,to), by = c("from","to"))
ligands = lr_network %>% pull(from) %>% unique()
receptors = lr_network %>% pull(to) %>% unique()
SLC40A1$diff <- paste0(SLC40A1$Cancer,"-",SLC40A1$group)
Idents(SLC40A1) <- SLC40A1$diff
marker <- FindMarkers(SLC40A1,ident.1 = c("NSCLC-tumor.NR.post","BRC-tumor.NR.post"),ident.2 = c("CRC-tumor.NR.post"))
DE_table_receiver <- subset(marker,avg_log2FC>0) %>% rownames_to_column("gene")
geneset_oi = DE_table_receiver %>% pull(gene)
geneset_oi = geneset_oi %>% .[. %in% rownames(ligand_target_matrix)]
CD45@active.ident <- as.factor(CD45$group)
expressed_genes_receiver = get_expressed_genes('tumor.NR.post', CD45, pct = 0.3,assay_oi = 'RNA')
background_expressed_genes = expressed_genes_receiver %>% .[. %in% rownames(ligand_target_matrix)]
expressed_ligands = ligands
expressed_receptors = intersect(receptors,expressed_genes_receiver)
potential_ligands = lr_network %>% filter(from %in% expressed_ligands & to %in% expressed_receptors) %>% pull(from) %>% unique()
ligand_activities = predict_ligand_activities(geneset = geneset_oi, background_expressed_genes = background_expressed_genes,ligand_target_matrix = ligand_target_matrix, potential_ligands = potential_ligands)
ligand_activities = ligand_activities %>% arrange(-pearson) %>% mutate(rank = rank(dplyr::desc(pearson)))
ligand_activities
best_upstream_ligands = ligand_activities %>% top_n(5, pearson) %>% arrange(-pearson) %>% pull(test_ligand) %>% unique()
active_ligand_target_links_df = best_upstream_ligands %>% lapply(get_weighted_ligand_target_links,geneset = geneset_oi, ligand_target_matrix = ligand_target_matrix, n = 250) %>% bind_rows() %>% drop_na()
active_ligand_target_links = prepare_ligand_target_visualization(ligand_target_df = active_ligand_target_links_df, ligand_target_matrix = ligand_target_matrix, cutoff = 0.1)
order_ligands = intersect(best_upstream_ligands, colnames(active_ligand_target_links)) %>% rev() %>% make.names()
order_targets = active_ligand_target_links_df$target %>% unique() %>% intersect(rownames(active_ligand_target_links)) %>% make.names()
rownames(active_ligand_target_links) = rownames(active_ligand_target_links) %>% make.names()
colnames(active_ligand_target_links) = colnames(active_ligand_target_links) %>% make.names() 
vis_ligand_target = active_ligand_target_links[order_targets,order_ligands] %>% t()
p_ligand_target_network = vis_ligand_target %>% make_heatmap_ggplot("Prioritized ligands","Predicted target genes", color = "#B2182B",legend_position = "top", x_axis_position = "top",legend_title = "Regulatory potential")+ theme(axis.text.x = element_text(face = "italic"),axis.text=element_text(color='black')) +scale_fill_gradient2(low = "whitesmoke",  high = "#B2182B")
p_ligand_target_network
lr_network_top = lr_network %>% filter(from %in% best_upstream_ligands & to %in% expressed_receptors) %>% distinct(from,to)
best_upstream_receptors = lr_network_top %>% pull(to) %>% unique()
lr_network_top_df_large = weighted_networks_lr %>% filter(from %in% best_upstream_ligands & to %in% best_upstream_receptors)
lr_network_top_df = lr_network_top_df_large %>% spread("from","weight",fill = 0)
lr_network_top_matrix = lr_network_top_df %>% dplyr::select(-to) %>% 
  as.matrix() %>% magrittr::set_rownames(lr_network_top_df$to)
dist_receptors = stats::dist(lr_network_top_matrix, method = "binary")
hclust_receptors = hclust(dist_receptors, method = "ward.D2")
order_receptors = hclust_receptors$labels[hclust_receptors$order]
dist_ligands = dist(lr_network_top_matrix %>% t(), method = "binary")
hclust_ligands = hclust(dist_ligands, method = "ward.D2")
order_ligands_receptor = hclust_ligands$labels[hclust_ligands$order]
order_receptors = order_receptors %>% intersect(rownames(lr_network_top_matrix))
order_ligands_receptor = order_ligands_receptor %>% intersect(colnames(lr_network_top_matrix))
vis_ligand_receptor_network = lr_network_top_matrix[order_receptors, order_ligands_receptor]
rownames(vis_ligand_receptor_network) = order_receptors %>% make.names()
colnames(vis_ligand_receptor_network) = order_ligands_receptor %>% make.names()
p_ligand_receptor_network = vis_ligand_receptor_network %>% t() %>%make_heatmap_ggplot("Ligands","Receptors", color = "mediumvioletred", legend_position = "right",x_axis_position = "top",legend_title = "Prior interaction potential")
p_ligand_receptor_network
ligand_pearson_matrix = ligand_activities %>% dplyr::select(pearson) %>% as.matrix() %>% magrittr::set_rownames(ligand_activities$test_ligand)
rownames(ligand_pearson_matrix) = rownames(ligand_pearson_matrix) %>% make.names()
colnames(ligand_pearson_matrix) = colnames(ligand_pearson_matrix) %>% make.names()
vis_ligand_pearson = ligand_pearson_matrix[order_ligands, ] %>% as.matrix(ncol = 1) %>% magrittr::set_colnames("Pearson")
p_ligand_pearson = vis_ligand_pearson %>% make_heatmap_ggplot("Prioritized ligands","Ligand activity",color = "darkorange",legend_position = "right",x_axis_position = "top", legend_title = "Pearson correlation coefficient") +theme(legend.text = element_text(size = 9))
p_ligand_pearson


##Figure 3G
SPP1 <- subset(Mono,idents="Macro_SPP1")
SPP1$diff <- paste0(SPP1$Cancer,"-",SPP1$group)
Idents(SPP1) <- SPP1$diff
diff <- FindMarkers(SPP1,ident.1 = c("NSCLC-tumor.NR.post"),ident.2 = c("HNSCC-tumor.NR.post"),min.pct = 0.1,logfc.threshold = 0.2)
diff$names <- rownames(diff)
diff.R <- subset(diff,diff$avg_log2FC>0)
diff.NR <- subset(diff,diff$avg_log2FC<0)
gene.R <- bitr(diff.R$names,fromType = 'SYMBOL',toType = 'ENTREZID',OrgDb = GO_database)
gene.NR <- bitr(diff.NR$names,fromType = 'SYMBOL',toType = 'ENTREZID',OrgDb = GO_database)
GO.R<-enrichGO( gene.R$ENTREZID,OrgDb = GO_database,keyType = "ENTREZID",ont = "ALL",pvalueCutoff = 0.05,qvalueCutoff = 0.05,readable = TRUE)
GO.NR<-enrichGO( gene.NR$ENTREZID, OrgDb = GO_database,keyType = "ENTREZID",ont = "ALL",pvalueCutoff = 0.05,qvalueCutoff = 0.05,readable = TRUE)
BP_top10.UP.R <-GO.R%>% filter(ONTOLOGY=="BP")%>%arrange(p.adjust)%>%head(10)
BP_top10.DOWN.NR <-GO.NR%>% filter(ONTOLOGY=="BP")%>%arrange(p.adjust)%>%head(10)
BP_top10.UP.R$group <- "NSCLC"
BP_top10.DOWN.NR$group <- "HNSCC"
GO <- rbind(BP_top10.DOWN.NR,BP_top10.UP.R)
GO$Count <- as.numeric(GO$Count)
GO.sorted_descriptions <- GO %>%arrange(group, p.adjust) %>%distinct(Description) %>%pull(Description)
GO$Description <- factor(GO$Description, levels = GO.sorted_descriptions)
GO$Description <- as.character(GO$Description)
GO$Description <- as.factor(GO$Description)
GO$Description <- fct_inorder(GO$Description)
ggplot(GO, aes(x = Count, y = Description, fill = group)) + 
  geom_bar(stat = "identity", width = 0.7) +
  theme_bw() +
  theme(
    axis.text.x = element_text(angle = 90, hjust = 1, vjust = 0.5,colour = "black",face="bold",size = 10),
    axis.text.y = element_text(size = 14, colour = "#222222"),
    legend.title = element_text(size = 10)
  ) +
  scale_fill_manual(values = c("NSCLC" = "red", "HNSCC" = "blue")) + 
  labs(x = NULL, y = NULL) +
  guides(fill = guide_legend(order = 3)) +
  scale_y_discrete(position = "right") + 
  theme(title = element_text(size = 13))+labs(title = "Macro_SPP1:tumor.NR.post")


##Figure 3H & I
Idents(Mono) <- Mono$cell.type
SPP1 <- subset(Mono,idents="Macro_SPP1")
Idents(SPP1) <- SPP1$group
SPP1 <- subset(SPP1,idents="tumor.NR.post")
Angiogenesis <- read.table("Angiogenesis")
Angiogenesis <- as.character(Angiogenesis$V1)
Anti.inflammatory <- read.table("anti-inflammatory")
Anti.inflammatory <- as.character(Anti.inflammatory$V1)


cells_rankings <- AUCell_buildRankings(SPP1@assays$RNA@data,plotStats = FALSE)
cells_AUC.anti <- AUCell_calcAUC(Anti.inflammatory, cells_rankings,aucMaxRank=nrow(cells_rankings)*0.1)
cells_AUC.anti <- as.numeric(getAUC(cells_AUC.anti))
SPP1$Anti.inflammatory <- cells_AUC.anti

cells_AUC.Angiogenesis <- AUCell_calcAUC(Angiogenesis, cells_rankings,aucMaxRank=nrow(cells_rankings)*0.1)
cells_AUC.Angiogenesis <- as.numeric(getAUC(cells_AUC.Angiogenesis))
SPP1$Angiogenesis <- cells_AUC.Angiogenesis
SPP1$diff <- paste0(SPP1$Cancer,"-",SPP1$group)
meta <- SPP1@meta.data
meta <- meta[,c("Cancer","Anti.inflammatory","Angiogenesis")]
meta$Cancer <- factor(meta$Cancer,levels = c("NSCLC","HNSCC"))
meta.Anti.inflammatory <- meta %>%mutate(Anti.inflammatory = scale(Anti.inflammatory))
meta.Anti.inflammatory <- meta.Anti.inflammatory %>%group_by(Cancer) %>%summarise(Anti-inflammatory_mean = mean(Anti.inflammatory, na.rm = TRUE)) %>%ungroup()
meta.Angiogenesis <- meta %>%mutate(Angiogenesis = scale(Angiogenesis))
meta.Angiogenesis <- meta.Angiogenesis %>%group_by(Cancer) %>%summarise(Hypoxic_mean = mean(Angiogenesis, na.rm = TRUE)) %>%ungroup()
meta <- cbind(meta.Anti.inflammatory,meta.Hypoxic)
meta <- meta[,-3]
meta1 <- melt(meta,id.vars = "Cancer",measure.vars = c("Anti-inflammatory_mean","Hypoxic_mean"))
meta1$variable <- gsub("_mean","",meta1$variable)
meta1$diff <- paste0(meta1$Cancer,"-",meta1$group)
ggplot(meta1, aes(x = diff, y = variable, fill = value)) +
  geom_tile(color = "white", linewidth = 0.3) +
  scale_fill_gradientn(
    colours = colors,
    name = "Score (Z-score)",
    limits = c(-1, 1)
  ) +
  labs(title = "Anti-inflammatory & Angiogenesis score in Macro_SPP1") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1,size = 12,colour = "black"),
        axis.text.y = element_text(size = 12,colour = "black"),
        axis.title = element_blank(),
        legend.text = element_text(size = 11),
        legend.title = element_text(size = 12),
        plot.title = element_text(hjust = 0.5, face = "bold"))

Idents(SPP1) <- SPP1$diff
SPP1$diff <- factor(SPP1$diff,levels=c("NSCLC-tumor.NR.post","NSCLC-tumor.R.post""HNSCC-tumor.NR.post","HNSCC-tumor.R.post"))
DotPlot(SPP1, features = c("HAVCR2","LGALS9","VEGFB","CXCR4"))+ scale_colour_gradientn(colours  = brewer.pal(9, "RdBu")[9:1],na.value="transparent")+theme(axis.title=element_blank(),axis.text.y =element_text(size = 12),axis.text.x = element_text(size = 12,angle = 90,vjust = 0.5,face = "italic"),strip.background =element_rect(colour = "white")) +labs(title = "LAG3 & IL10")

