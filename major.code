x=as.data.frame(Mono@active.ident)
df1 <- Mono@reductions$umap@cell.embeddings
df1<- cbind(df1,as.data.frame(Mono@meta.data))
get_density <-function(x,y,...){
dens <- MASS::kde2d(x,y,...)
ix <- findInterval(x,dens$x)
iy <- findInterval(y,dens$y)
ii <- cbind(ix,iy)
return(dens$z[ii])
}
for(i in unique(df1$responsess)){
id <- which(df1$responsess==i)
gd <- get_density(df1$UMAP_1[id],df1$UMAP_2[id],n=100)
df1[id,"Density"] <- gd/max(gd)
}
